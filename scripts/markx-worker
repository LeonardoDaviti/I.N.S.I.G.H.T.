# ---------------------------------------------------------------------------------------------- errors

class ServerUnreachable(Exception):
    pass


class ServerSlow(ServerUnreachable):
    """The server answered nothing within the timeout (v10.13.2): a lease of one kind is skipped for the cycle."""


class ServerError(Exception):
    def __init__(self, msg, code=None):
        super().__init__(msg)
        self.code = code


class ServerAuth(Exception):
    pass


# ---------------------------------------------------------------------------------------------- the log

class Log:
    """The JSON-lines log (--log). v10.17: rotated by size, so a worker run by a timer for months never fills the
    disk: past `max_bytes` the file becomes log.jsonl.1 (.1 -> .2 ...), and the `keep` newest old files stay. Two
    worker processes may share the file (an embed cycle beside a read cycle): each write and rotation holds an
    exclusive flock on log.jsonl.lock, so a line is never written to a file another process is renaming."""
    MAX_BYTES = 10 * 1024 * 1024
    KEEP = 4

    def __init__(self, path, quiet=False, max_bytes=None, keep=None):
        self.path = Path(path) if path else None
        self.quiet = quiet
        self.max_bytes = self.MAX_BYTES if max_bytes is None else max_bytes
        self.keep = self.KEEP if keep is None else keep
        self.lock = threading.Lock()
        if self.path:
            self.path.parent.mkdir(parents=True, exist_ok=True)

    def _rotate(self):
        if self.keep < 1:
            self.path.unlink(missing_ok=True)
            return
        for n in range(self.keep - 1, 0, -1):
            older = self.path.with_name(f"{self.path.name}.{n}")
            if older.exists():
                os.replace(older, self.path.with_name(f"{self.path.name}.{n + 1}"))
        os.replace(self.path, self.path.with_name(f"{self.path.name}.1"))

    def _write(self, line):
        import fcntl
        with open(self.path.with_name(self.path.name + ".lock"), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                if self.max_bytes and self.path.exists() and self.path.stat().st_size >= self.max_bytes:
                    self._rotate()
                with self.path.open("a") as f:
                    f.write(line)
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)

    def __call__(self, event, **rec):
        rec = {"at": datetime.now(timezone.utc).isoformat(timespec="seconds"), "event": event, **rec}
        with self.lock:
            if self.path:
                self._write(json.dumps(rec, ensure_ascii=False) + "\n")
            if not self.quiet:
                brief = " ".join(f"{k}={v}" for k, v in rec.items() if k not in ("at", "event") and v is not None)
                print(f"markx-worker {event} {brief}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------------------------- the server

class Server:
    def __init__(self, base, token, timeout=60):
        self.base = base.rstrip("/")
        self.token = token
        self.timeout = timeout

    def _req(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.base + path, data=data, method=method, headers={
            "Authorization": f"Bearer {self.token}", "Accept": "application/json",
            **({"Content-Type": "application/json"} if data is not None else {})})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise ServerAuth(f"{method} {path}: {e.code}") from None
            detail = e.read()[:300].decode("utf-8", "replace")
            raise ServerError(f"{method} {path}: {e.code} {detail}", e.code) from None
        except (socket.timeout, TimeoutError) as e:
            raise ServerSlow(f"{method} {path}: timed out") from None
        except urllib.error.URLError as e:
            if isinstance(e.reason, (socket.timeout, TimeoutError)):
                raise ServerSlow(f"{method} {path}: timed out") from None
            raise ServerUnreachable(f"{method} {path}: {getattr(e, 'reason', e)}") from None
        except (ConnectionError, OSError) as e:
            raise ServerUnreachable(f"{method} {path}: {getattr(e, 'reason', e)}") from None
        try:
            return json.loads(raw.decode() or "null")
        except ValueError:
            raise ServerError(f"{method} {path}: not JSON: {raw[:200]!r}") from None

    def work(self, kind, limit, worker, days=None):
        q = {"kinds": kind, "limit": limit, "worker": worker}
        if days is not None:
            q["days"] = days
        q = urllib.parse.urlencode(q)
        return self._req("GET", f"/api/markx/work?{q}")

    def answers(self, payload):
        return self._req("POST", "/api/markx/answers", payload)

    def release(self, worker, task_ids=None):
        body = {"worker": worker}
        if task_ids is not None:
            body["task_ids"] = list(task_ids)
        return self._req("POST", "/api/markx/release", body)

    def status(self):
        return self._req("GET", "/api/markx/status")

    def embeddings(self, payload):
        return self._req("POST", "/api/markx/embeddings", payload)


# ---------------------------------------------------------------------------------------------- the embedder

class EmbedderDown(Exception):
    pass


class EmbedderError(Exception):
    pass


def file_sha256(path):
    """The GGUF's sha256, remembered in the state directory by path, size and modification time."""
    p = Path(path).expanduser().resolve()
    st = p.stat()
    memo = state_dir() / "gguf-sha256.json"
    key = f"{p}|{st.st_size}|{int(st.st_mtime)}"
    try:
        known = json.loads(memo.read_text())
    except (OSError, ValueError):
        known = {}
    if key in known:
        return known[key]
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    known[key] = h.hexdigest()
    try:
        memo.parent.mkdir(parents=True, exist_ok=True)
        memo.write_text(json.dumps(known))
    except OSError:
        pass
    return known[key]


def pack(vector):
    """A vector scaled to length 1, as 1,024 little-endian float16, base64."""
    norm = sum(x * x for x in vector) ** 0.5
    if not norm:
        raise EmbedderError("a zero vector")
    return base64.b64encode(struct.pack(f"<{len(vector)}e", *[x / norm for x in vector])).decode("ascii")


class Embedder:
    """A local `llama-server --embedding --pooling cls`: POST /embedding {"content": [texts]}."""

    def __init__(self, url, timeout=600):
        self.url = url.rstrip("/")
        self.timeout = timeout

    def _req(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method,
                                     headers={"Content-Type": "application/json"} if data else {})
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            raise EmbedderError(f"{path}: {e.code} {e.read()[:300].decode('utf-8', 'replace')}") from None
        except (urllib.error.URLError, ConnectionError, socket.timeout, TimeoutError, OSError) as e:
            raise EmbedderDown(f"{self.url}{path}: {getattr(e, 'reason', e)}") from None
        try:
            return json.loads(raw.decode() or "null")
        except ValueError:
            raise EmbedderError(f"{path}: not JSON") from None

    def model_path(self):
        props = self._req("GET", "/props") or {}
        return props.get("model_path")

    def embed(self, texts):
        """One vector a text, in order (the pooled vector: a list of numbers, or a list holding one)."""
        res = self._req("POST", "/embedding", {"content": list(texts)})
        if isinstance(res, dict) and "embedding" in res:
            res = [res]
        if not isinstance(res, list) or len(res) != len(texts):
            got = len(res) if isinstance(res, list) else "no"
            raise EmbedderError(f"/embedding: {got} vectors for {len(texts)} texts")
        out = [None] * len(texts)
        for n, e in enumerate(res):
            v = e.get("embedding") if isinstance(e, dict) else None
            if isinstance(v, list) and v and isinstance(v[0], list):
                if len(v) != 1:
                    raise EmbedderError("/embedding: a vector a token (start llama-server with --pooling cls)")
                v = v[0]
            if not isinstance(v, list) or not v:
                raise EmbedderError("/embedding: an answer without a vector")
            k = e.get("index") if isinstance(e.get("index"), int) else n
            if not 0 <= k < len(out):
                raise EmbedderError(f"/embedding: index {k} out of range")
            out[k] = v
        if any(v is None for v in out):
            raise EmbedderError("/embedding: a text without a vector")
        return out


# ---------------------------------------------------------------------------------------------- claude -p

def days_arg(value):
    """--days: "all" or a whole number of days, 1 to 36500 (0112 Decided 9)."""
    v = value.strip().lower()
    if v == "all" or (v.isdigit() and 1 <= int(v) <= 36500):
        return v
    raise argparse.ArgumentTypeError('a number of days (1 to 36500) or "all"')


def per_call_arg(value):
    """--per-call: "kind=N[,kind=N]", N at least 1: {kind: N}."""
    out = {}
    for part in [x.strip() for x in value.split(",") if x.strip()]:
        kind, eq, n = part.partition("=")
        if not eq or not kind.strip() or not n.strip().isdigit() or int(n) < 1:
            raise argparse.ArgumentTypeError('kind=N[,kind=N] with N at least 1, e.g. "merge=1"')
        out[kind.strip()] = int(n)
    return out


def cache_arg(value):
    """--prompt-cache: "mode[,kind=mode]" (0191), a mode one of PROMPT_CACHE: {"*": every kind's, kind: its own}."""
    out = {"*": "default"}
    for part in [x.strip() for x in value.split(",") if x.strip()]:
        kind, eq, mode = part.rpartition("=") if "=" in part else ("*", "=", part)
        if mode.strip() not in PROMPT_CACHE or not kind.strip():
            raise argparse.ArgumentTypeError(f'mode[,kind=mode], a mode one of {", ".join(sorted(PROMPT_CACHE))}')
        out[kind.strip()] = mode.strip()
    return out


def effort_arg(value):
    """--effort: "kind=level[,kind=level]" (0191), a level one of EFFORTS or "default" (Claude Code's own): {kind: level}."""
    out = {}
    for part in [x.strip() for x in value.split(",") if x.strip()]:
        kind, eq, level = part.partition("=")
        level = level.strip()
        if not eq or not kind.strip() or level not in EFFORTS + ("default",):
            raise argparse.ArgumentTypeError(f'kind=level[,kind=level], a level one of {", ".join(EFFORTS)} or default')
        out[kind.strip()] = level
    return out


# ---------------------------------------------------------------------------------------------- the server's checks

_RULES = []   # [module or None]: the server's validate.py, loaded once


def server_rules():
    """0191: the server's own answer checks (backend/insight_core/markx/validate.py, standard library only) when this
    worker runs from INSIGHT's checkout, so an answer the server would refuse (a span or a version not in the post) is
    asked again in the same cycle; None elsewhere (the schema alone is checked, as before)."""
    if not _RULES:
        mod = None
        backend = Path(__file__).resolve().parent.parent / "backend"
        if (backend / "insight_core" / "markx" / "validate.py").is_file():
            sys.path.insert(0, str(backend))
            try:
                from insight_core.markx import validate as mod
            except Exception:   # an older or broken checkout: the schema alone
                mod = None
            finally:
                sys.path.remove(str(backend))
        _RULES.append(mod)
    return _RULES[0]


def rule_error(kind, answer, input, guide=None):
    """The server's input checks on an answer the schema passed (validate.CHECKS[kind]: spans and versions in the post,
    numbered items that exist ...), or None. A check that needs more than the standard library (back, subtopics) or
    that cannot read the answer is no opinion: the server still checks it."""
    rules = server_rules()
    check = ((getattr(rules, "GUIDE_CHECKS", {}).get(guide or "") or getattr(rules, "CHECKS", {}).get(kind))
             if rules else None)   # 0196: a guide variant's own checks first
    if check is None or kind in EMBED_KINDS:
        return None
    try:
        return check(rules.unwrap(kind, answer), input or "")
    except Exception:
        return None


def system_for(guide):
    """The guide's body, then its answer schema when it has one (v10.0.1): a guide's prose can leave a field's
    key unnamed (read-v2's mentions never say `name`), and the server refuses an answer without it."""
    schema = guide.get("schema")
    if not schema:
        return guide["body"]
    return (guide["body"].rstrip() + "\n\nEach answer object (after its \"id\") must match this JSON Schema, with "
            "exactly these field names:\n" + json.dumps(schema, ensure_ascii=False, separators=(",", ":")))


def claude_argv(claude, model, system, kind=None, effort=None):
    """No tools, except for a kind in WEB_KINDS (0171): Claude Code's web search tool only (allowed without a prompt,
    no fetch, no other tool), at most WEB_MAX_TURNS turns. `effort` (0191): --effort, last; None or "default": none."""
    tail = ["--effort", effort] if effort and effort != "default" else []
    if kind in WEB_KINDS:
        return [claude, "-p", "--model", model, "--tools", WEB_TOOL, "--system-prompt", system,
                "--output-format", "json", "--no-session-persistence", "--strict-mcp-config",
                "--allowedTools", WEB_TOOL, "--max-turns", str(WEB_MAX_TURNS)] + tail
    return [claude, "-p", "--model", model, "--tools", "", "--system-prompt", system,
            "--output-format", "json", "--no-session-persistence", "--strict-mcp-config"] + tail


def classify(text):
    """'auth', 'usage' or None, for the text of a failed call."""
    if AUTH_RE.search(text or ""):
        return "auth"
    if USAGE_RE.search(text or ""):
        return "usage"
    return None


def call(claude, model, system, prompt, timeout, kind=None, effort=None, env=None):
    """One `claude -p` call. Returns {text, ms, cost, tin, tout, model, cread, cwrite, think} or {error, fatal, ms}.
    `env` (0191): variables for Claude Code (its prompt cache), over this process's."""
    t0 = time.time()
    try:
        p = subprocess.run(claude_argv(claude, model, system, kind, effort), input=prompt, capture_output=True,
                           text=True, timeout=max(1, timeout), cwd=tempfile.gettempdir(),
                           env={**os.environ, **env} if env else None)
    except subprocess.TimeoutExpired:
        return {"error": "timeout", "fatal": None, "ms": int((time.time() - t0) * 1000)}
    except FileNotFoundError:
        return {"error": f"claude not found: {claude}", "fatal": "setup", "ms": 0}
    ms = int((time.time() - t0) * 1000)
    try:
        ev = json.loads(p.stdout)
        r = [x for x in ev if isinstance(x, dict) and x.get("type") == "result"][-1] if isinstance(ev, list) else ev
        if not isinstance(r, dict):
            raise ValueError("not an object")
    except (ValueError, IndexError):
        out = (p.stdout or "") + "\n" + (p.stderr or "")
        return {"error": f"unparsable output rc={p.returncode}: {out.strip()[:300]}", "fatal": classify(out), "ms": ms}
    if r.get("is_error") or r.get("subtype") != "success":
        msg = f"{r.get('subtype')}: {str(r.get('result'))[:300]}"
        return {"error": msg, "fatal": classify(str(r.get("result")) + " " + (p.stderr or "")), "ms": ms}
    u = r.get("usage") or {}
    mu = r.get("modelUsage") or {}
    used = max(mu, key=lambda k: (mu[k] or {}).get("outputTokens") or 0) if mu else None
    return {"text": r.get("result") or "", "ms": ms, "cost": float(r.get("total_cost_usd") or 0),
            "tin": (u.get("input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0)
                   + (u.get("cache_creation_input_tokens") or 0),
            "tout": u.get("output_tokens") or 0, "model": used,
            # 0191: the parts the price differs by (a cache read is 0.1x input, a 1-hour cache write 2x; thinking is output)
            "cread": u.get("cache_read_input_tokens") or 0, "cwrite": u.get("cache_creation_input_tokens") or 0,
            "think": (u.get("output_tokens_details") or {}).get("thinking_tokens") or 0}


def prompt_for(tasks):
    return HEAD + "\n\n".join(f"### ITEM id: {t['id']}\n{t['input']}" for t in tasks)


def parse_lines(text):
    """{str(task id): answer} from the model's JSON lines (the prototype's parser)."""
    out = {}
    for line in (text or "").replace("```json", "").replace("```", "").split("\n"):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(o, dict):
            continue
        key = "id" if "id" in o else "task_id" if "task_id" in o else None
        if key is None or o[key] in (None, ""):
            continue
        ans = {k: v for k, v in o.items() if k not in ("id", "task_id")}
        if set(ans) == {"answer"} and isinstance(ans["answer"], dict):
            ans = ans["answer"]
        out[str(o[key])] = ans
    return out


# ---------------------------------------------------------------------------------------------- the schema

_TYPES = {"object": dict, "array": list, "string": str, "boolean": bool, "null": type(None)}


def _is(value, t):
    if t == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if t == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return isinstance(value, _TYPES.get(t, object))


def schema_error(schema, value, path="answer"):
    """The first way value breaks schema (a JSON Schema subset), or None."""
    if schema is None or schema is True:
        return None
    if schema is False:
        return f"{path}: not allowed"
    if not isinstance(schema, dict):
        return None
    t = schema.get("type")
    if t is not None:
        ts = t if isinstance(t, list) else [t]
        if not any(_is(value, x) for x in ts):
            return f"{path}: not {'/'.join(ts)}"
    if "const" in schema and value != schema["const"]:
        return f"{path}: not {schema['const']!r}"
    if "enum" in schema and value not in schema["enum"]:
        return f"{path}: {value!r} not in {schema['enum']}"
    for key in ("anyOf", "oneOf"):
        if key in schema and all(schema_error(s, value, path) for s in schema[key]):
            return f"{path}: matches none of {key}"
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            return f"{path}: shorter than {schema['minLength']}"
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            return f"{path}: longer than {schema['maxLength']}"
        if "pattern" in schema and not re.search(schema["pattern"], value):
            return f"{path}: does not match {schema['pattern']}"
    if _is(value, "number"):
        if "minimum" in schema and value < schema["minimum"]:
            return f"{path}: below {schema['minimum']}"
        if "maximum" in schema and value > schema["maximum"]:
            return f"{path}: above {schema['maximum']}"
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            return f"{path}: fewer than {schema['minItems']} items"
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            return f"{path}: more than {schema['maxItems']} items"
        if isinstance(schema.get("items"), dict):
            for n, v in enumerate(value):
                err = schema_error(schema["items"], v, f"{path}[{n}]")
                if err:
                    return err
    if isinstance(value, dict):
        for k in schema.get("required", []):
            if k not in value:
                return f"{path}: {k} missing"
        props = schema.get("properties") or {}
        for k, v in value.items():
            if k in props:
                err = schema_error(props[k], v, f"{path}.{k}")
            elif "additionalProperties" in schema:
                err = schema_error(schema["additionalProperties"], v, f"{path}.{k}")
            else:
                err = None
            if err:
                return err
    return None


def check_answer(schema, answer):
    if not isinstance(answer, dict):
        return "answer: not an object"
    return schema_error(schema, answer) if schema else None


# ---------------------------------------------------------------------------------------------- helpers

def parse_time(v):
    if isinstance(v, (int, float)):
        return datetime.fromtimestamp(v, timezone.utc)
    d = datetime.fromisoformat(str(v).strip().replace("Z", "+00:00"))
    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)


def shares(total, n):
    """total split into n integer shares that add up to it."""
    total = int(total or 0)
    base, extra = divmod(total, n)
    return [base + (1 if k < extra else 0) for k in range(n)]


def split_calls(tasks, n):
    """0176 (0150 B): a lease's tasks of one kind and guide in calls of at most n, in order, never two tasks of the
    same post (the server's "post": a long post's windows) in one call: windows asked together answer from each other."""
    calls = []
    for t in tasks:
        post = t.get("post")
        for c in calls:
            if len(c) < n and (post is None or all(x.get("post") != post for x in c)):
                c.append(t)
                break
        else:
            calls.append([t])
    return calls


def read_token(path):
    p = Path(path).expanduser()
    try:
        token = p.read_text().strip()
    except OSError as e:
        raise SystemExit(f"markx-worker: cannot read the token file {p}: {e.strerror}") from None
    if not token:
        raise SystemExit(f"markx-worker: the token file {p} is empty")
    try:
        if p.stat().st_mode & 0o077:
            print(f"markx-worker: warning: {p} is readable by others (chmod 600 it)", file=sys.stderr)
    except OSError:
        pass
    return token


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(base) / "insight" / "markx-worker"


# ---------------------------------------------------------------------------------------------- the cycle

class Batch:
    def __init__(self, kind, guide_id, guide, tasks, lease_until, model=None):
        self.kind, self.guide_id, self.guide, self.tasks, self.lease_until = kind, guide_id, guide, tasks, lease_until
        self.model = model   # v10.18: the server's model for this kind (its config), else --model


class Worker:
    def __init__(self, args, server, log):
        self.a, self.server, self.log = args, server, log
        self.stop = threading.Event()
        self.fatal = None            # 'usage', 'auth', 'setup', 'server', 'token'
        self.fatal_why = None
        self.held = {}               # str(task id) -> task id as leased, for tasks not yet answered or released
        self.spent = {}              # str(task id) -> {tokens_in, tokens_out, ms, cost_usd}
        self.lock = threading.Lock()
        self.embedder = getattr(args, "embedder_client", None)
        self.embed_sha = getattr(args, "embedder_sha256", None)
        self.counts = {"leased": 0, "calls": 0, "posted": 0, "valid": 0, "server_invalid": 0, "released": 0,
                       "vectors": 0, "embed_ms": 0, "rule_invalid": 0,
                       "tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0}
        self.model_seen = None
        self.refused = self.load_refused()   # 0191: tasks and posts a refusal was isolated to before
        self.warm = {}                       # 0191: kind -> set once its first call under the 5-minute cache returned

    # -- fatal ------------------------------------------------------------------------------------------
    def set_fatal(self, kind, why):
        with self.lock:
            if self.fatal is None:
                self.fatal, self.fatal_why = kind, why
        self.stop.set()

    # -- the spool --------------------------------------------------------------------------------------
    def spool_path(self):
        return Path(self.a.spool).expanduser()

    def spool(self, payload):
        p = self.spool_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        with self.lock, p.open("a") as f:
            f.write(json.dumps(payload, ensure_ascii=False) + "\n")
        self.log("spooled", answers=len(payload.get("answers") or payload.get("vectors") or []), spool=str(p))

    def flush_spool(self):
        p = self.spool_path()
        if not p.exists() or not p.read_text().strip():
            return
        lines = [json.loads(x) for x in p.read_text().splitlines() if x.strip()]
        done = 0
        try:
            for payload in lines:
                if "vectors" in payload:
                    r = self.server.embeddings(payload)
                    self.note_vectors(payload, r)
                else:
                    r = self.server.answers(payload)
                    self.note_posted(payload, r)
                done += 1
        finally:
            rest = lines[done:]
            p.write_text("".join(json.dumps(x, ensure_ascii=False) + "\n" for x in rest))
            self.log("spool", posted=done, left=len(rest))

    # -- posting ----------------------------------------------------------------------------------------
    def note_posted(self, payload, r):
        r = r or {}
        valid = r.get("valid")
        nvalid = len(valid) if isinstance(valid, list) else int(valid or 0)
        invalid = r.get("invalid") or []
        with self.lock:
            self.counts["posted"] += len(payload["answers"])
            self.counts["valid"] += nvalid
            self.counts["server_invalid"] += len(invalid)
        for x in invalid:
            self.log("server-invalid", task=x.get("task_id"), error=str(x.get("error"))[:300])

    def post(self, answers, model):
        if not answers:
            return
        payload = {"worker": self.a.worker, "executor": EXECUTOR, "model": model or self.a.model,
                   "answers": answers}
        for attempt in range(1, self.a.post_tries + 1):
            try:
                r = self.server.answers(payload)
            except ServerAuth as e:
                self.spool(payload)
                self.set_fatal("token", str(e))
                return
            except (ServerUnreachable, ServerError) as e:
                self.log("post-failed", attempt=attempt, error=str(e)[:300])
                if attempt < self.a.post_tries:
                    time.sleep(self.a.retry_wait * attempt)
                    continue
                self.spool(payload)
                self.set_fatal("server", str(e))
                return
            self.note_posted(payload, r)
            with self.lock:
                for x in answers:
                    self.held.pop(str(x["task_id"]), None)
            return

    def answer_row(self, task, answer):
        s = self.spent.get(str(task["id"]), {})
        return {"task_id": task["id"], "answer": answer, "tokens_in": s.get("tokens_in", 0),
                "tokens_out": s.get("tokens_out", 0), "ms": s.get("ms", 0),
                "cost_usd": round(s.get("cost_usd", 0.0), 8)}

    # -- one call ---------------------------------------------------------------------------------------
    def cache_mode(self, kind):
        """0191: the kind's prompt-cache mode (--prompt-cache's)."""
        modes = self.a.prompt_cache or {"*": "default"}
        return modes.get(kind, modes.get("*", "default"))

    def effort(self, kind):
        """0191: the kind's --effort level (--effort's, else EFFORT's), or None (Claude Code's default)."""
        level = (self.a.effort or {}).get(kind)
        return None if level in (None, "default") else level

    def ask(self, batch, tasks, attempt):
        """Asks one call. Returns (ok [(task, answer)], invalid [(task, answer, error)], missing [task], late,
        model, refused) or None when no call was made."""
        if self.stop.is_set():
            return None
        left = (batch.lease_until - datetime.now(timezone.utc)).total_seconds()
        if left < self.a.lease_margin:
            self.log("lease-expiring", kind=batch.kind, attempt=attempt, size=len(tasks), seconds_left=int(left))
            return None
        res = call(self.a.claude, batch.model or self.a.model, system_for(batch.guide), prompt_for(tasks),
                   timeout=self.a.timeout, kind=batch.kind, effort=self.effort(batch.kind),
                   env=PROMPT_CACHE[self.cache_mode(batch.kind)])
        late = datetime.now(timezone.utc) > batch.lease_until
        ok, invalid, missing = [], [], []
        ruled = 0
        if "text" in res:
            got = parse_lines(res["text"])
            n = len(tasks)
            for t, tin, tout, ms in zip(tasks, shares(res["tin"], n), shares(res["tout"], n), shares(res["ms"], n)):
                with self.lock:
                    s = self.spent.setdefault(str(t["id"]), {"tokens_in": 0, "tokens_out": 0, "ms": 0, "cost_usd": 0.0})
                    s["tokens_in"] += tin
                    s["tokens_out"] += tout
                    s["ms"] += ms
                    s["cost_usd"] += res["cost"] / n
                a = got.get(str(t["id"]))
                if a is None:
                    missing.append(t)
                    continue
                err = check_answer(batch.guide.get("schema"), a)
                if err is None and not self.a.no_server_rules:
                    err = rule_error(batch.kind, a, t.get("input"), batch.guide_id)   # 0191: what the server would refuse
                    ruled += err is not None
                (invalid.append((t, a, err)) if err else ok.append((t, a)))
            with self.lock:
                self.counts["calls"] += 1
                self.counts["tokens_in"] += res["tin"]
                self.counts["tokens_out"] += res["tout"]
                self.counts["cost_usd"] += res["cost"]
                self.counts["rule_invalid"] += ruled
                self.model_seen = res.get("model") or self.model_seen
        else:
            missing = list(tasks)
            with self.lock:
                self.counts["calls"] += 1
        refused = "text" not in res and bool(REFUSAL.search(str(res.get("error") or "")))
        self.log("call", kind=batch.kind, guide=batch.guide_id, attempt=attempt, size=len(tasks), ok=len(ok),
                 invalid=len(invalid), missing=len(missing), ms=res.get("ms"), cost_usd=res.get("cost"),
                 tokens_in=res.get("tin"), tokens_out=res.get("tout"), model=res.get("model"),
                 cache_read=res.get("cread"), cache_write=res.get("cwrite"), thinking=res.get("think"),
                 effort=self.effort(batch.kind), rule_invalid=ruled or None, refused=refused or None,
                 late=late or None, error=res.get("error"),
                 invalid_errors=[e for _, _, e in invalid][:5] or None)
        if res.get("fatal"):
            self.set_fatal(res["fatal"], res["error"])
        return ok, invalid, missing, late, res.get("model"), refused

    # -- refusals (0191) ----------------------------------------------------------------------------------
    def refused_path(self):
        return self.spool_path().with_name("refused.json")

    def load_refused(self):
        """{"tasks": {task id: kind}, "posts": {post id: kind}}: what a usage-policy refusal was isolated to before."""
        try:
            got = json.loads(self.refused_path().read_text())
            return {"tasks": dict(got.get("tasks") or {}), "posts": dict(got.get("posts") or {})}
        except (OSError, ValueError, AttributeError):
            return {"tasks": {}, "posts": {}}

    def known_refused(self, task):
        with self.lock:
            return (str(task["id"]) in self.refused["tasks"]
                    or (task.get("post") is not None and str(task["post"]) in self.refused["posts"]))

    def remember_refused(self, kind, task):
        """A task a refusal stood alone on: never batched again (its later leases ask it alone), kept across cycles in
        refused.json beside the spool (the newest REFUSED_KEEP)."""
        with self.lock:
            self.refused["tasks"][str(task["id"])] = kind
            if task.get("post") is not None:
                self.refused["posts"][str(task["post"])] = kind
            for k in ("tasks", "posts"):
                over = len(self.refused[k]) - REFUSED_KEEP
                for key in list(self.refused[k])[:max(0, over)]:
                    del self.refused[k][key]
            try:
                p = self.refused_path()
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(json.dumps(self.refused))
            except OSError:
                pass

    def isolate(self, batch, attempt):
        """A refused call answers no task of it: halves it until the refused task stands alone (2026-11-08), from the
        first refusal on (0191: before, the first refused call was asked once more whole). A task refused alone is
        posted as an empty answer (the server stores a failed try; three and the task fails) and remembered."""
        if len(batch.tasks) > 1:
            half = len(batch.tasks) // 2
            for part in (batch.tasks[:half], batch.tasks[half:]):
                self.second(Batch(batch.kind, batch.guide_id, batch.guide, part, batch.lease_until, batch.model),
                            attempt)
            return
        t = batch.tasks[0]
        first_line = (t.get("input") or "").split("\n", 1)[0]
        platform = first_line[len("Platform: "):].split(" ", 1)[0] if first_line.startswith("Platform: ") else None
        self.log("refused", kind=batch.kind, task=t["id"], post=t.get("post"), chars=len(t.get("input") or ""),
                 platform=platform, again=self.known_refused(t) or None)
        self.remember_refused(batch.kind, t)
        self.post([self.answer_row(t, {})], None)

    # -- a round ----------------------------------------------------------------------------------------
    def first(self, batch):
        r = self.ask(batch, batch.tasks, 1)
        if r is None:
            return []
        ok, invalid, missing, late, model, refused = r
        if refused and not late:
            self.isolate(batch, 2)
            return []
        rows = [self.answer_row(t, a) for t, a in ok]
        if late:   # the lease is gone: no retry; the invalid ones are stored with their errors
            rows += [self.answer_row(t, a) for t, a, _ in invalid]
            self.post(rows, model)
            return []
        self.post(rows, model)
        return [t for t, _, _ in invalid] + missing

    def second(self, batch, attempt=2):
        r = self.ask(batch, batch.tasks, attempt)
        if r is None:
            return
        ok, invalid, missing, late, model, refused = r
        if refused and not late:
            self.isolate(batch, attempt)
            return
        self.post([self.answer_row(t, a) for t, a in ok] + [self.answer_row(t, a) for t, a, _ in invalid], model)

    # -- embeddings -------------------------------------------------------------------------------------
    def note_vectors(self, payload, r):
        r = r or {}
        with self.lock:
            self.counts["posted"] += len(payload["vectors"])
            self.counts["vectors"] += int(r.get("stored") or 0)
            self.counts["server_invalid"] += len(r.get("invalid") or [])
        for x in r.get("invalid") or []:
            self.log("server-invalid", task=x.get("task_id"), error=str(x.get("error"))[:300])

    def post_vectors(self, rows):
        if not rows:
            return
        payload = {"worker": self.a.worker, "model": self.a.embed_model, "model_sha256": self.embed_sha,
                   "vectors": rows}
        for attempt in range(1, self.a.post_tries + 1):
            try:
                r = self.server.embeddings(payload)
            except ServerAuth as e:
                self.spool(payload)
                self.set_fatal("token", str(e))
                return
            except ServerError as e:
                if e.code in (400, 409):     # another build or model: the same vectors would be refused again
                    self.set_fatal("build", str(e))
                    return
                err = e
            except ServerUnreachable as e:
                err = e
            else:
                self.note_vectors(payload, r)
                with self.lock:
                    for x in rows:
                        self.held.pop(str(x["task_id"]), None)
                return
            self.log("post-failed", attempt=attempt, error=str(err)[:300])
            if attempt < self.a.post_tries:
                time.sleep(self.a.retry_wait * attempt)
                continue
            self.spool(payload)
            self.set_fatal("server", str(err))

    def embed_texts(self, tasks):
        """[(task, vector or None)]: the batch in one request, else one text at a time."""
        try:
            return list(zip(tasks, self.embedder.embed([t["input"] for t in tasks])))
        except EmbedderError as e:
            if len(tasks) == 1:
                self.log("embed-refused", task=tasks[0]["id"], error=str(e)[:300])
                return [(tasks[0], None)]
            self.log("embed-batch-refused", size=len(tasks), error=str(e)[:300])
        out = []
        for t in tasks:
            out += self.embed_texts([t])
        return out

    def embed(self, batch):
        """One embed batch: the embedder, then the vectors posted (no retry round)."""
        if self.stop.is_set():
            return
        left = (batch.lease_until - datetime.now(timezone.utc)).total_seconds()
        if left < self.a.lease_margin:
            self.log("lease-expiring", kind=batch.kind, size=len(batch.tasks), seconds_left=int(left))
            return
        t0 = time.time()
        try:
            got = self.embed_texts(batch.tasks)
        except EmbedderDown as e:
            self.set_fatal("setup", f"the embedder is unreachable: {e}")
            return
        ms = int((time.time() - t0) * 1000)
        done = [(t, v) for t, v in got if v is not None]
        rows = []
        for (t, v), share in zip(done, shares(ms, max(1, len(done)))):
            if len(v) != EMBED_DIMENSIONS:
                self.set_fatal("setup", f"the embedder gives {len(v)} dimensions, not {EMBED_DIMENSIONS}")
                return
            try:
                rows.append({"task_id": t["id"], "vector": pack(v), "ms": share})
            except EmbedderError as e:
                self.log("embed-refused", task=t["id"], error=str(e))
        with self.lock:
            self.counts["calls"] += 1
            self.counts["embed_ms"] += ms
        self.log("embed", size=len(batch.tasks), vectors=len(rows), ms=ms,
                 ms_per_post=round(ms / max(1, len(rows)), 1))
        self.post_vectors(rows)

    def per_call(self, kind):
        """Tasks per call of `kind`: --per-call's, else --batch."""
        return max(1, min(self.a.batch, (self.a.per_call or {}).get(kind, self.a.batch)))

    def lease_size(self, kind):
        """Tasks per lease of `kind` (v10.13.3): --lease, else --batch (the server takes LEASE_MAX at most), and no
        more than --parallel calls of the kind, so a lease of one-a-call tasks (merge) never queues more calls than
        the callers start at once while its 30 minutes run."""
        return max(1, min(LEASE_MAX, self.a.lease or self.a.batch, self.per_call(kind) * self.a.parallel))

    def lease(self, kind):
        t0 = time.monotonic()
        w = self.server.work(kind, self.lease_size(kind), self.a.worker, self.a.days) or {}
        ms = int((time.monotonic() - t0) * 1000)   # v10.13.4: the server's time for this lease (planning included)
        tasks = w.get("tasks") or []
        if not tasks:
            self.log("leased", kind=kind, tasks=0, ms=ms)
            return [], 0
        until = parse_time(w["lease_until"])
        guides = w.get("guides") or {}
        groups = {}
        for t in tasks:
            groups.setdefault((t.get("kind") or kind, t["guide"]), []).append(t)
            with self.lock:
                self.held[str(t["id"])] = t["id"]
        with self.lock:
            self.counts["leased"] += len(tasks)
        out = []
        for (k, gid), ts in groups.items():
            g = guides.get(gid)
            if not g or not g.get("body"):
                self.log("guide-missing", kind=k, guide=gid, tasks=len(ts))
                continue
            if g.get("sha256") and hashlib.sha256(g["body"].encode()).hexdigest() != g["sha256"]:
                self.log("guide-sha256-mismatch", kind=k, guide=gid, tasks=len(ts))
                continue
            n = self.per_call(k)
            alone = [t for t in ts if self.known_refused(t)]   # 0191: a task a refusal was isolated to: asked alone
            ts = [t for t in ts if not self.known_refused(t)]
            model = next((t.get("model") for t in ts if t.get("model")), None)   # v10.18: a kind's model
            out += [Batch(k, gid, g, c, until, model) for c in split_calls(ts, n)]   # 0176: one window of a post a call
            out += [Batch(k, gid, g, [t], until, model) for t in alone]
        self.log("leased", kind=kind, tasks=len(tasks), ms=ms, lease_until=until.isoformat(timespec="seconds"))
        return out, len(tasks)

    def cycle(self):
        try:
            self.flush_spool()
        except ServerAuth as e:
            return self.finish("token", str(e))
        except (ServerUnreachable, ServerError) as e:
            return self.finish("server", str(e))
        kinds = [k.strip() for k in self.a.kinds.split(",") if k.strip()]
        # v10.13.3: a pipeline, not rounds. One thread leases (kinds in turn, as before) into a short queue, and
        # --parallel callers each take the next batch as soon as they are free: Haiku no longer waits for the leases
        # of a round, nor a round for its slowest call. The queue holds --parallel batches; the leaser waits on it.
        ready = queue.Queue(maxsize=max(1, self.a.parallel))
        callers = [threading.Thread(target=self.call_loop, args=(ready,), name=f"caller-{i}", daemon=True)
                   for i in range(self.a.parallel)]
        for t in callers:
            t.start()
        self.lease_all(kinds, ready, len(callers))
        for t in callers:
            t.join()
        return self.finish(self.fatal, self.fatal_why)

    def call_loop(self, ready):
        """A caller (v10.13.3): batches from `ready` until None; after a stop the rest are only taken off (their
        tasks are released by finish, or left to expire when the server or the token failed)."""
        while True:
            b = ready.get()
            if b is None:
                return
            if not self.stop.is_set():
                self.run_batch(b)

    def lease_all(self, kinds, ready, callers):
        """The leaser (v10.13.3): --batches leases, kinds taking turns (v10.12.1; --drain: each until dry), each
        lease's batches put on `ready`; a None for each caller at the end."""
        done, leased, turn, slow = set(), 0, 0, 0
        try:
            while leased < self.a.batches and not self.stop.is_set():
                if self.a.drain:
                    kind = next((k for k in kinds if k not in done), None)
                else:
                    kind = None
                    for _ in range(len(kinds)):
                        k = kinds[turn % len(kinds)]
                        turn += 1
                        if k not in done:
                            kind = k
                            break
                if kind is None:
                    break
                try:
                    bs, n = self.lease(kind)
                except ServerAuth as e:
                    self.set_fatal("token", str(e))
                    break
                except ServerSlow as e:
                    # v10.13.2: one kind's lease took longer than the timeout (its planner is slow on the server):
                    # that kind sits out this cycle, the others go on (its tasks, if leased, come back at the lease's end)
                    self.log("lease-slow", kind=kind, error=str(e)[:300])
                    done.add(kind)
                    slow += 1
                    if slow >= SLOW_LEASES:          # every kind slow: the server is down in all but name
                        self.set_fatal("server", str(e))
                        break
                    continue
                except ServerError as e:
                    if e.code == 400 and "unknown kind" in str(e):
                        # v10.14: a worker newer than its server (a kind added before the deploy): that kind sits
                        # out, the others go on; never a stop, which would hold every kind until the server updates
                        self.log("kind-unknown", kind=kind, error=str(e)[:300])
                        done.add(kind)
                        continue
                    self.set_fatal("server", str(e))
                    break
                except ServerUnreachable as e:
                    self.set_fatal("server", str(e))
                    break
                except (KeyError, ValueError, TypeError, AttributeError) as e:
                    self.set_fatal("server", f"bad /work answer: {e!r}")
                    break
                slow = 0
                if n < self.lease_size(kind):
                    done.add(kind)
                if n:
                    leased += 1
                    for b in bs:
                        ready.put(b)
        except Exception as e:   # a bug in the leaser: stop, never exit 0
            self.log("bug", where="leaser", error=repr(e)[:300])
            self.set_fatal("bug", repr(e)[:300])
        finally:
            for _ in range(callers):
                ready.put(None)

    def warmed(self, b):
        """first(b); 0191: under the 5-minute cache, a kind's first call of the cycle goes alone and the kind's other
        calls wait for it (at most --timeout), so they read its guide from the cache instead of each writing it."""
        if self.cache_mode(b.kind) != "5m":
            return self.first(b)
        with self.lock:
            ready = self.warm.get(b.kind)
            warmer = ready is None
            if warmer:
                ready = self.warm[b.kind] = threading.Event()
        if not warmer:
            ready.wait(self.a.timeout)
            return self.first(b)
        try:
            return self.first(b)
        finally:
            ready.set()

    def run_batch(self, b):
        """One batch, start to end: embedded, or asked, then its invalid and missing tasks asked once more in calls
        of per_call(kind) (as a round's retry did before v10.13.3)."""
        try:
            if b.kind in EMBED_KINDS:
                self.embed(b)
                return
            if self.stop.is_set():
                return
            todo = self.warmed(b)
            if not todo or self.stop.is_set() or self.a.no_retry:
                return
            n = self.per_call(b.kind)
            for k in range(0, len(todo), n):
                if self.stop.is_set():
                    return
                self.second(Batch(b.kind, b.guide_id, b.guide, todo[k:k + n], b.lease_until, b.model))
        except Exception as e:   # a bug: logged, the cycle stops and exits 1 (never 0)
            self.log("bug", where="batch", kind=b.kind, error=repr(e)[:300])
            self.set_fatal("bug", repr(e)[:300])

    def finish(self, fatal, why):
        try:
            if fatal in ("usage", "auth", "setup", "build"):
                r = self.server.release(self.a.worker)
                self.counts["released"] += int((r or {}).get("released") or 0)
                self.held.clear()
            elif self.held and fatal not in ("server", "token"):
                r = self.server.release(self.a.worker, list(self.held.values()))
                self.counts["released"] += int((r or {}).get("released") or len(self.held))
                self.held.clear()
        except (ServerUnreachable, ServerError, ServerAuth) as e:
            self.log("release-failed", error=str(e)[:300], held=len(self.held))
            fatal, why = fatal or "server", why or str(e)
        self.counts["cost_usd"] = round(self.counts["cost_usd"], 6)
        code = {None: EXIT_OK, "usage": EXIT_USAGE, "auth": EXIT_AUTH, "setup": EXIT_SETUP, "build": EXIT_BUILD,
                "server": EXIT_SERVER, "token": EXIT_TOKEN, "bug": EXIT_BUG}[fatal]
        self.log("done", exit=code, stopped=fatal, why=(why or None) and str(why)[:300], **self.counts)
        return code


# ---------------------------------------------------------------------------------------------- the CLI

def main(argv=None):
    ap = argparse.ArgumentParser(prog="markx-worker", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--server", required=True, help="INSIGHT's address, e.g. http://<server>:5173")
    common.add_argument("--token-file", required=True, help="a file holding the bearer token")
    common.add_argument("--worker", default=socket.gethostname(), help="this worker's name (default: the host)")
    common.add_argument("--log", default=str(state_dir() / "log.jsonl"), help="JSON-lines log ('' for none; rotated past 10 MB, 4 old files kept)")
    common.add_argument("--quiet", action="store_true", help="no log lines on stderr")
    c = sub.add_parser("cycle", parents=[common], help="lease, ask Haiku, post")
    c.add_argument("--kinds", default=DEFAULT_KINDS, help="task kinds, in order (default: %(default)s)")
    c.add_argument("--batch", type=int, default=20, help="tasks per call (default 20)")
    c.add_argument("--drain", action="store_true",
                   help="lease each kind until it runs dry before the next (default: kinds take turns, v10.12.1)")
    c.add_argument("--per-call", type=per_call_arg, default=per_call_arg(PER_CALL),
                   help="tasks per call for some kinds, at most --batch (default " + PER_CALL + ": a merge is asked alone; "
                        "a lease takes --lease, at most --parallel calls of the kind)")
    c.add_argument("--effort", type=effort_arg, default=effort_arg(EFFORT),
                   help="Claude Code's thinking effort by kind, kind=level (low, medium, high, xhigh, max or default); "
                        "default " + EFFORT + " (0191: measured per kind); a kind not named: Claude Code's default")
    c.add_argument("--prompt-cache", type=cache_arg, default=cache_arg(DEFAULT_PROMPT_CACHE),
                   help="Claude Code's prompt cache, mode[,kind=mode], a mode one of off, 5m or default (Claude "
                        "Code's own); default " + DEFAULT_PROMPT_CACHE + " (0191: 'default' writes each prompt to the "
                        "1-hour cache at 2x input, which calls of distinct items never read back)")
    c.add_argument("--no-server-rules", action="store_true",
                   help="check answers against the guide's schema only, not also the server's validate.py (0191)")
    c.add_argument("--lease", type=int, default=None,
                   help="tasks per lease, at most 100 (default --batch); a call still asks --batch / --per-call of them")
    c.add_argument("--batches", type=int, default=5, help="leases per cycle (default 5)")
    c.add_argument("--parallel", type=int, default=3, help="calls at once (default 3; start at 10 at most and raise "
                   "it in steps: about 100 at once broke the device's DNS)")
    c.add_argument("--days", type=days_arg, default=None,
                   help="read, entities and embed: the server plans this window first (a number of days, or 'all'), "
                        "whatever the page's reading window (default: the page's)")
    c.add_argument("--model", default="haiku", help="claude --model (default haiku)")
    c.add_argument("--claude", default=os.environ.get("MARKX_CLAUDE", "claude"), help="the claude binary")
    c.add_argument("--timeout", type=float, default=1800, help="seconds per call at most (default 1800)")
    c.add_argument("--lease-margin", type=float, default=120, help="no call with less lease left (default 120 s)")
    c.add_argument("--server-timeout", type=float, default=60, help="seconds a request to the server may take (default 60)")
    c.add_argument("--post-tries", type=int, default=3, help="tries per post (default 3)")
    c.add_argument("--retry-wait", type=float, default=2.0, help="seconds between post tries, times the try")
    c.add_argument("--no-retry", action="store_true", help="no retry of missing or invalid answers")
    c.add_argument("--spool", default=str(state_dir() / "spool.jsonl"), help="answers not yet delivered")
    c.add_argument("--embedder", help="for the embed kind: a local llama-server --embedding's address")
    c.add_argument("--embedder-gguf", help="the embedder's GGUF, for its sha256 (default: the model_path of its /props)")
    c.add_argument("--embed-model", default="bge-m3", help="the model id the vectors are stored under (default bge-m3)")
    sub.add_parser("status", parents=[common], help="print the server's Mark X status")
    sub.add_parser("release", parents=[common], help="hand back this worker's leased tasks")
    a = ap.parse_args(argv)
    if a.cmd == "cycle" and (a.batch < 1 or a.batches < 1 or a.parallel < 1 or a.post_tries < 1):
        ap.error("--batch, --batches, --parallel and --post-tries must be at least 1")
    if a.cmd == "cycle" and a.lease is not None and not 1 <= a.lease <= LEASE_MAX:
        ap.error(f"--lease must be 1 to {LEASE_MAX} (the server's most a lease)")

    try:
        token = read_token(a.token_file)
    except SystemExit as e:
        print(e, file=sys.stderr)
        return EXIT_SETUP
    server = Server(a.server, token, timeout=getattr(a, "server_timeout", 60))
    log = Log(a.log or None, quiet=a.quiet)
    try:
        if a.cmd == "status":
            print(json.dumps(server.status(), indent=1, ensure_ascii=False))
            return EXIT_OK
        if a.cmd == "release":
            r = server.release(a.worker)
            log("released", worker=a.worker, released=(r or {}).get("released"))
            return EXIT_OK
    except ServerAuth as e:
        log("stopped", why=f"the server refused the token: {e}")
        return EXIT_TOKEN
    except (ServerUnreachable, ServerError) as e:
        log("stopped", why=str(e)[:300])
        return EXIT_SERVER
    if set(EMBED_KINDS) & {k.strip() for k in a.kinds.split(",")}:
        if not a.embedder:
            log("stopped", why="the embed kind needs --embedder (a local llama-server --embedding)")
            return EXIT_SETUP
        a.embedder_client = Embedder(a.embedder)
        try:
            gguf = a.embedder_gguf or a.embedder_client.model_path()
            if not gguf:
                raise EmbedderError("its /props names no model_path: pass --embedder-gguf")
            a.embedder_sha256 = file_sha256(gguf)
        except (EmbedderDown, EmbedderError, OSError) as e:
            log("stopped", why=f"the embedder's build: {e}")
            return EXIT_SETUP
        log("embedder", url=a.embedder, gguf=str(gguf), sha256=a.embedder_sha256)
    log("start", worker=a.worker, server=a.server, kinds=a.kinds, batch=a.batch, batches=a.batches,
        parallel=a.parallel, model=a.model,
        prompt_cache=",".join(f"{k}={v}" if k != "*" else v for k, v in a.prompt_cache.items()),
        server_rules=None if a.no_server_rules else server_rules() is not None)
    return Worker(a, server, log).cycle()


if __name__ == "__main__":
    sys.exit(main())
