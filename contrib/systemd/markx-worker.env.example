# ~/.config/insight/markx-worker.env: what markx-worker.service runs (DEPLOYMENT.md, "Workers that survive a reboot").
# The worker script, from your checkout (absolute path).
MARKX_WORKER=/home/<you>/<checkout>/scripts/markx-worker
# The cycle's arguments, as you would type them after `markx-worker cycle`.
MARKX_ARGS=--server http://<server>:5173 --token-file /home/<you>/.config/insight/markx-token --kinds read,entities --batch 20 --batches 5 --parallel 3
# For the embed kind instead (needs llama-server.service):
# MARKX_ARGS=--server http://<server>:5173 --token-file /home/<you>/.config/insight/markx-token --kinds embed --embedder http://127.0.0.1:8091 --batch 100 --batches 50
