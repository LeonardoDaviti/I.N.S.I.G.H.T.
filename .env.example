# API keys and sessions are NOT set here. Add them in the app under Sources → Connections
# (Telegram API ID/hash and sign-in, the Substack cookie); they are stored encrypted in the
# database. This file keeps only infrastructure: database, ports, CORS and intervals.
#
# Moving from an older .env that still has TELEGRAM_API_ID, TELEGRAM_API_HASH or SUBSTACK_SID?
# Run once, then delete those lines:
#   docker compose exec backend python -m insight_core.scripts.import_env_secrets
#
# The encryption key for Connections is generated into the insight_secrets volume on the
# first save (INSIGHT_SECRET_KEY_PATH, default /app/secrets/secret.key), or set one here
# (a Fernet key). Keep it: values saved with another key cannot be read.
# INSIGHT_SECRET_KEY=

# INSIGHT fetches only from hosts on public addresses, except its bridges (issue 0187): telegram.local,
# nitter.local and the hosts in NITTER_HOSTS, TELEGRAM_RSS_HOSTS, INSIGHT_MEDIA_PRIVATE_HOSTS and
# RSS_SKIP_TLS_VERIFY_HOSTS. Another LAN host you read from (comma separated hosts):
# INSIGHT_MEDIA_PRIVATE_HOSTS=rsshub.lan
INSIGHT_MEDIA_PRIVATE_HOSTS=

# Optional for self-hosted HTTPS feeds with self-signed certs (a bridge on a LAN address needs none), for example:
# RSS_SKIP_TLS_VERIFY_HOSTS=feeds.lan
RSS_SKIP_TLS_VERIFY_HOSTS=

# A Telegram RSS bridge you run or trust (hosts or origins, comma separated; the first is used
# when you add a public channel from Add source). Empty: no bridge, and the dialog says so
# (follow channels through Connections -> Telegram instead). Unset: https://telegram.local.
TELEGRAM_RSS_HOSTS=

# Your Nitter for X accounts (hosts or origins, comma separated; the first is used when you paste an
# x.com address in Add source). Unset: https://nitter.local, as before. Set empty: none.
# NITTER_HOSTS=nitter.example

# Bluesky profiles (bsky.app/profile/<handle>) read on the public API (issue 0137). Off by default:
# a profile address is then read as any page (its RSS link, if it has one).
INSIGHT_BLUESKY=off

# Reddit is read through its public RSS/JSON feeds: no account or API key. Optional
# User-Agent for those requests:
REDDIT_USER_AGENT=

DB_USER=insight
DB_PASSWORD=insight
DB_NAME=insight
DB_HOST=localhost
DB_PORT=5432

# Admin Database (for creating database)
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application Database (generated from above)
DATABASE_URL=postgresql://insight:insight@localhost:5432/insight

# Connection pool, per process (API and ingestion each have one). Defaults shown.
# INSIGHT_DB_POOL_MIN=1
# INSIGHT_DB_POOL_MAX=10
# INSIGHT_DB_POOL_TIMEOUT_SECONDS=10
# INSIGHT_DB_STATEMENT_TIMEOUT_MS=300000
# Issue 0188 (DEPLOYMENT.md, "Health, timeouts, memory and logs"): an API request's statements end after this
# (0 turns it off); the jobs' timeouts follow their time limit and need no setting.
# INSIGHT_DB_REQUEST_TIMEOUT_MS=30000
# Memory limits per container (docker compose units), above the measured peaks; and each container's own log size.
# INSIGHT_INGESTION_MEM_LIMIT=12g
# INSIGHT_API_MEM_LIMIT=10g
# INSIGHT_DB_MEM_LIMIT=6g
# INSIGHT_FRONTEND_MEM_LIMIT=256m
# INSIGHT_DOCKER_LOG_SIZE=20m
# A backup (scripts/backup) before each ./update's migrations; off by default. Backups kept; tagged builds kept.
# INSIGHT_BACKUP_ON_UPDATE=1
# INSIGHT_BACKUPS_KEEP=5
# INSIGHT_IMAGES_KEEP=3
# Migrations (db/migrate.py): each one's lock wait in seconds, and its tries.
# INSIGHT_MIGRATION_LOCK_TIMEOUT=10
# INSIGHT_MIGRATION_LOCK_RETRIES=5

# API Configuration
API_PORT=8000
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
# Leave blank to use same-origin /api via the frontend Nginx proxy.
# Set explicitly only if your frontend should call a different backend URL.
VITE_API_URL=
CORS_ALLOW_ORIGINS=

# Ingestion / Scheduling
# Fetch cadence is adaptive per source (Mark IX); these tune the error backoff ladder.
# INSIGHT_BACKOFF_BASE_MINUTES=60
# INSIGHT_BACKOFF_MAX_HOURS=24
# INSIGHT_BACKOFF_DORMANT_AFTER=10
# INSIGHT_BACKOFF_DORMANT_MAX_HOURS=168
# Daily work (prune, cadence refresh) every N hours;
# the ingestion tick (only due sources are fetched) every N minutes, minimum 15.
INSIGHT_INGEST_INTERVAL_HOURS=20
INSIGHT_INGEST_TICK_MINUTES=60
# The export of your sources, rewritten after each change (the database is the truth).
INSIGHT_SOURCES_JSON_PATH=backend/insight_core/config/sources.json
