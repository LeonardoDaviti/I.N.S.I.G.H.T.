TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Secrets can be added in the UI instead: Sources → Connections (stored encrypted; a value
# saved there wins over this file). The encryption key is generated into the insight_secrets
# volume on first save, or set it here (a Fernet key):
# INSIGHT_SECRET_KEY=

# Telegram MTProto (the bare-handle telegram sources). Sign in under Sources → Connections,
# or create a session file once: docker compose run --rm -it backend python -m insight_core.scripts.telegram_login
# The file lives in the bind-mounted config/ dir, so it survives image rebuilds:
# TELEGRAM_SESSION_PATH=/app/insight_core/config/telegram/insight.session

# Substack paid posts (the substack kind): the substack.sid cookie of the owner's logged-in
# browser session. Prefer Sources → Connections; this is the fallback (restart the backend
# and ingestion containers after changing it). Without it, paid posts are stored truncated.
# SUBSTACK_SID=

# Optional for self-hosted HTTPS feeds with self-signed certs, for example:
# RSS_SKIP_TLS_VERIFY_HOSTS=telegram.local,nitter.local
RSS_SKIP_TLS_VERIFY_HOSTS=

REDDIT_CLIENT_ID= 
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_USERNAME=
REDDIT_PASSWORD=

DB_USER=insight
DB_PASSWORD=insight
DB_NAME=insight
DB_HOST=localhost
DB_PORT=5432

# Admin Database (for creating database)
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Application Database (generated from above)
DATABASE_URL=postgresql://insight:insight@localhost:5432/insight

# Gemini AI API Key (optional; if unset, deterministic fallback briefings are used)
GEMINI_API_KEY=your_gemini_api_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
# Leave blank to use same-origin /api via the frontend Nginx proxy.
# Set explicitly only if your frontend should call a different backend URL.
VITE_API_URL=
CORS_ALLOW_ORIGINS=

# Analysis (entity/event memory, experts, briefings, stories, inbox). Default off: a
# reading-only app. Off saves posts without enrichment, skips experts and briefings in the
# daily work, builds no Gemini client and answers 409 on the analysis endpoints. Set on in
# both the backend env and the frontend build arg (VITE_INSIGHT_ANALYSIS) to bring it back.
INSIGHT_ANALYSIS=off

# Ingestion / Scheduling
# Fetch cadence is adaptive per source (Mark IX); these tune the error backoff ladder.
# INSIGHT_BACKOFF_BASE_MINUTES=60
# INSIGHT_BACKOFF_MAX_HOURS=24
# INSIGHT_BACKOFF_DORMANT_AFTER=10
# INSIGHT_BACKOFF_DORMANT_MAX_HOURS=168
# Daily work (prune, cadence refresh, sources.json sync, experts, briefings) every N hours;
# the ingestion tick (only due sources are fetched) every N minutes, minimum 15.
INSIGHT_INGEST_INTERVAL_HOURS=20
INSIGHT_INGEST_TICK_MINUTES=60
INSIGHT_SYNC_SOURCES_EACH_CYCLE=true
INSIGHT_GENERATE_DAILY_BRIEFING=true
INSIGHT_GENERATE_TOPIC_BRIEFING=false
INSIGHT_SOURCES_JSON_PATH=backend/insight_core/config/sources.json

# Gemini model routing
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.0-flash

# Langfuse tracing (optional; if unset/disabled, tracing is a no-op).
# Set LANGFUSE_ENABLED=true and fill the keys to turn it on once integrated.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
